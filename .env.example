# dsLib configuration — copy to .env and fill in real values.
#   cp .env.example .env
# Never commit .env. Every value below is a placeholder.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
# Bind to localhost in production and let Nginx reverse-proxy to it.
HOST=127.0.0.1
PORT=3000

# Set to true ONLY when running behind a reverse proxy you control (Nginx).
# It makes the app trust X-Forwarded-* headers; trusting them when not behind
# a proxy would let a visitor spoof their IP and defeat rate limiting.
TRUST_PROXY=false

# --- Security -------------------------------------------------------------
# Session cookie signing secret. Must be at least 32 characters.
# The app refuses to start in production without one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Idle timeout: a session dies after this many minutes without a request.
SESSION_IDLE_MINUTES=480
# Absolute cap: a session dies this many minutes after login, active or not.
SESSION_ABSOLUTE_MINUTES=720

# --- Database -------------------------------------------------------------
# Path to the SQLite file. Back this up by copying it (see README).
DATABASE_PATH=./data/library.db

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=./data/uploads
# Maximum accepted cover image size, in bytes (2 MB).
MAX_UPLOAD_BYTES=2097152

# --- Library settings -----------------------------------------------------
# Default loan period offered when checking out a copy.
DEFAULT_LOAN_DAYS=14
# Default interface language: el or en.
DEFAULT_LANG=el
# Public name of the library, shown in page headers and titles.
LIBRARY_NAME=Σχολική Βιβλιοθήκη
