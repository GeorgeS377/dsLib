<%#
  Flash messages carried over a redirect. Each one is a translation key plus
  variables, so a message queued in one language renders in whichever language
  the reader is using when it is shown.
-%>
<% if (flash && flash.length > 0) { %>
  <ul class="flash-list">
    <% flash.forEach(function (message) { %>
      <%
        const flashIcon = message.type === 'success' ? 'check'
          : message.type === 'error' ? 'close'
          : message.type === 'warning' ? 'warning'
          : 'tag';
      %>
      <li class="flash flash--<%= message.type %>"
          role="<%= message.type === 'error' ? 'alert' : 'status' %>">
        <%- include('./icon', { name: flashIcon, size: 18 }) %>
        <span><%= t(message.key, message.vars || undefined) %></span>
      </li>
    <% }); %>
  </ul>
<% } %>
