<%#
  The catalogue filter bar.

  Shared by the home page and the catalogue page, so filtering works the same
  in both places. Always visible rather than folded behind a disclosure: the
  whole point of the page is narrowing a list, and a hidden control is one
  nobody finds.

  Checkboxes, not <select multiple>. A multi-select is multi-select in theory
  and single-select in practice: picking a second option needs Ctrl+click,
  which nothing on screen tells you, and the chosen row renders in the
  browser's grey so it reads as disabled rather than selected. A checkbox is
  one click, obvious, and reachable from the keyboard.

  Several values of one filter mean "either"; different filters still combine
  with "and".

  Sort lives here too, so one Apply button covers the whole "show me these
  books, in this order" question. Deliberately no auto-submit — with
  checkboxes it would reload the page after every single tick.

  Expects: query, categories, authors, years, languages, action, hasFilters,
  clearUrl, and t.
-%>
<form class="filters" method="get" action="<%= action %>">
  <% if (query.q) { %>
    <input type="hidden" name="q" value="<%= query.q %>">
  <% } %>

  <div class="filters__row">
    <fieldset class="filter">
      <legend class="filter__label"><%= t('search.filter.category') %></legend>
      <div class="filter__options">
        <% categories.forEach(function (category) { %>
          <label class="filter__option">
            <input type="checkbox" name="category" value="<%= category.id %>"
                   <%= query.category.includes(category.id) ? 'checked' : '' %>>
            <span class="filter__option-name" title="<%= category.name %>"><%= category.name %></span>
            <span class="filter__option-count"><%= category.book_count %></span>
          </label>
        <% }); %>
      </div>
    </fieldset>

    <fieldset class="filter">
      <legend class="filter__label"><%= t('search.filter.author') %></legend>
      <div class="filter__options">
        <% authors.forEach(function (author) { %>
          <label class="filter__option">
            <input type="checkbox" name="author" value="<%= author.id %>"
                   <%= query.author.includes(author.id) ? 'checked' : '' %>>
            <span class="filter__option-name" title="<%= author.name %>"><%= author.name %></span>
            <span class="filter__option-count"><%= author.book_count %></span>
          </label>
        <% }); %>
      </div>
    </fieldset>

    <% if (years.length > 0) { %>
      <fieldset class="filter filter--narrow">
        <legend class="filter__label"><%= t('search.filter.year') %></legend>
        <div class="filter__options">
          <% years.forEach(function (year) { %>
            <label class="filter__option">
              <input type="checkbox" name="year" value="<%= year %>"
                     <%= query.year.includes(year) ? 'checked' : '' %>>
              <span class="filter__option-name"><%= year %></span>
            </label>
          <% }); %>
        </div>
      </fieldset>
    <% } %>

    <%# Language and sort are genuinely one-of-many, so they stay as menus. -%>
    <div class="filter filter--stack">
      <% if (languages.length > 1) { %>
        <div>
          <label class="filter__label" for="f-language"><%= t('search.filter.language') %></label>
          <select id="f-language" name="language">
            <option value=""><%= t('search.filter.allLanguages') %></option>
            <% languages.forEach(function (code) { %>
              <option value="<%= code %>" <%= query.language === code ? 'selected' : '' %>>
                <%= code %>
              </option>
            <% }); %>
          </select>
        </div>
      <% } %>

      <div>
        <label class="filter__label" for="f-sort"><%= t('search.sort.label') %></label>
        <select id="f-sort" name="sort">
          <% ['title', 'title_desc', 'author', 'newest', 'year_desc', 'year'].forEach(function (option) { %>
            <option value="<%= option %>" <%= (query.sort || 'title') === option ? 'selected' : '' %>>
              <%= t('search.sort.' + option) %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>
  </div>

  <div class="filters__actions">
    <div class="checkbox-row">
      <input type="checkbox" id="f-available" name="available" value="1"
             <%= query.available ? 'checked' : '' %>>
      <label for="f-available"><%= t('search.filter.availableOnly') %></label>
    </div>

    <div class="button-row">
      <button class="button button--small" type="submit">
        <%= t('common.apply') %>
      </button>
      <% if (hasFilters) { %>
        <a class="button button--quiet button--small" href="<%= clearUrl %>">
          <%= t('search.clearFilters') %>
        </a>
      <% } %>
    </div>
  </div>
</form>
