<%#
  The staff top bar. One bar, not two.

  It was split into an identity band above a tab row, which read as two
  separate top bars stacked on top of each other. Everything now sits on one
  line: where you are on the left, where you can go in the middle, and who you
  are plus the way out on the right.

  Shared with the sign-in page, which previously had no bar at all — so the
  only way back to the public catalogue was a link in the footer. `signedIn`
  is false there: no tabs, no user, no sign-out, but the same bar and the same
  way back.

  Expects: t, lang, supportedLangs, langUrl, theme, themeUrl, currentPath,
  signedIn, and (when signed in) staffUser and csrfToken.
-%>
<header class="staff-bar">
  <div class="container staff-bar__inner">
    <a class="staff-brand" href="<%= signedIn ? '/staff' : '/' %>">
      <%- include('./icon', { name: 'archive', size: 18 }) %>
      <span><%= t('staff.area') %></span>
    </a>

    <% if (signedIn) { %>
      <nav class="staff-tabs" aria-label="<%= t('nav.menu') %>">
        <%
          const sections = [
            { href: '/staff', key: 'staff.nav.dashboard', exact: true },
            { href: '/staff/books', key: 'staff.nav.books' },
            { href: '/staff/loans', key: 'staff.nav.loans' },
            { href: '/staff/borrowers', key: 'staff.nav.borrowers' },
          ];
          // One entry for everything occasional, active for any page it covers.
          const settingsPaths = [
            '/staff/settings', '/staff/categories', '/staff/authors',
            '/staff/users', '/staff/account',
          ];
          const settingsActive = settingsPaths.some(function (p) {
            return currentPath.startsWith(p);
          });
        %>
        <% sections.forEach(function (item) { %>
          <%
            const active = item.exact
              ? currentPath === item.href || currentPath.startsWith(item.href + '?')
              : currentPath.startsWith(item.href);
          %>
          <a class="staff-tabs__tab" href="<%= item.href %>"<% if (active) { %> aria-current="page"<% } %>>
            <%= t(item.key) %>
          </a>
        <% }); %>
        <a class="staff-tabs__tab" href="/staff/settings"
           <% if (settingsActive) { %>aria-current="page"<% } %>>
          <%= t('staff.nav.settings') %>
        </a>
      </nav>
    <% } %>

    <div class="staff-bar__end">
      <%# Always present, signed in or not: leaving should never require
          hunting in the footer. -%>
      <a class="staff-bar__public" href="/">
        <%- include('./icon', { name: 'book', size: 16 }) %>
        <span><%= t('staff.viewPublicSite') %></span>
      </a>

      <%- include('./theme-toggle', { theme: theme, themeUrl: themeUrl, t: t }) %>

      <span class="lang-switch">
        <% supportedLangs.forEach(function (code) { %>
          <% if (code !== lang) { %>
            <a class="lang-switch__link" href="<%= langUrl(code) %>" lang="<%= code %>"><%= code.toUpperCase() %></a>
          <% } %>
        <% }); %>
      </span>

      <% if (signedIn && staffUser) { %>
        <%# Plain text, not a bordered pill: it is a label saying who you are,
            and a border made it look like a button that did something. -%>
        <a class="staff-bar__user" href="/staff/account">
          <span class="staff-bar__user-name"><%= staffUser.display_name %></span>
          <span class="staff-bar__user-role"><%= t('staff.role.' + staffUser.role) %></span>
        </a>

        <form class="inline-form" method="post" action="/staff/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="button button--danger-solid button--small" type="submit">
            <%- include('./icon', { name: 'logout', size: 16 }) %>
            <span><%= t('staff.logout') %></span>
          </button>
        </form>
      <% } %>
    </div>
  </div>
</header>
