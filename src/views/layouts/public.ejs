<!DOCTYPE html>
<%#
  data-theme is written server-side from a cookie rather than by script on
  load. Setting it in JavaScript would repaint the page after first paint and
  flash the light palette at someone who chose dark.
-%>
<html lang="<%= lang %>"<% if (theme === 'dark') { %> data-theme="dark"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' + libraryName : libraryName %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : t('footer.catalogue') %>">
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
</head>
<body>
  <a class="skip-link" href="#main"><%= t('nav.skip') %></a>

  <%#
    Three fixed positions: library name left, search in the middle, language
    right. No navigation links — browsing happens on one catalogue page where
    category, author, year and availability are filters, so a second set of
    destinations here would be a parallel route to the same books.

    The search box is hidden on the home page, which has its own.
  -%>
  <header class="site-header">
    <div class="container site-header__inner">
      <a class="site-brand" href="/">
        <%- include('../partials/icon', { name: 'book', size: 22, iconClass: 'site-brand__mark' }) %>
        <span class="site-brand__name"><%= libraryName %></span>
      </a>

      <% if (!(typeof hideHeaderSearch !== 'undefined' && hideHeaderSearch)) { %>
        <form class="site-header__search" method="get" action="/books" role="search">
          <label class="visually-hidden" for="header-q"><%= t('common.searchLabel') %></label>
          <input type="search" id="header-q" name="q"
                 value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>"
                 placeholder="<%= t('common.searchPlaceholder') %>" autocomplete="off">
          <button class="button button--small" type="submit"><%= t('common.search') %></button>
        </form>
      <% } %>

      <div class="site-header__end">
        <%- include('../partials/theme-toggle', { theme: theme, themeUrl: themeUrl, t: t }) %>
        <div class="lang-switch" role="group" aria-label="<%= t('lang.label') %>">
          <% supportedLangs.forEach(function (code) { %>
            <% if (code !== lang) { %>
              <a class="lang-switch__link" href="<%= langUrl(code) %>" lang="<%= code %>"><%= code.toUpperCase() %></a>
            <% } %>
          <% }); %>
        </div>
      </div>
    </div>
  </header>

  <main id="main" class="site-main">
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <nav class="site-footer__links" aria-label="<%= t('nav.browseBy') %>">
        <a href="/books"><%= t('nav.catalogue') %></a>
        <a href="/categories"><%= t('nav.categories') %></a>
        <a href="/authors"><%= t('nav.authors') %></a>
      </nav>

      <%# Staff sign-in sits on the right, apart from the browse links: it is
          for one or two people, not for the students the rest serves. -%>
      <p class="site-footer__staff"><a href="/staff"><%= t('nav.staff') %></a></p>
    </div>
  </footer>

  <%# Progressive enhancement only — every page works without this file. -%>
  <script src="/assets/js/app.js" defer></script>
</body>
</html>
