<!DOCTYPE html>
<html lang="<%= lang %>"<% if (theme === 'dark') { %> data-theme="dark"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= t('staff.area') %></title>
  <%# The staff area must never be indexed, even if it somehow becomes
      reachable from outside. Authentication is the real control; this is
      belt and braces. -%>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/assets/css/app.css">
  <%- include('../partials/brand-head', { brandIcon: brandIcon }) %>
</head>
<body>
  <a class="skip-link" href="#main"><%= t('nav.skip') %></a>

  <%- include('../partials/staff-topbar', {
        t: t, lang: lang, supportedLangs: supportedLangs, langUrl: langUrl,
        theme: theme, themeUrl: themeUrl, currentPath: currentPath,
        signedIn: true, staffUser: staffUser, csrfToken: csrfToken }) %>

  <main id="main" class="site-main">
    <div class="container">
      <%- include('../partials/flash', { flash: flash, t: t }) %>
    </div>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <p class="small faint"><%= libraryName %></p>
      <%# The only change this redesign makes to the first interface: a way
          into the second one. Remove this line and the trial disappears. -%>
      <a class="small" href="<%= uiUrl('next') %>"><%= t('ui.toNext') %></a>
    </div>
  </footer>

  <script src="/assets/js/app.js" defer></script>
</body>
</html>
