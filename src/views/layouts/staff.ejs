<!DOCTYPE html>
<html lang="<%= lang %>"<% if (theme === 'dark') { %> data-theme="dark"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= t('staff.area') %></title>
  <%# The staff area must never be indexed, even if it somehow becomes
      reachable from outside. Authentication is the real control; this is
      belt and braces. -%>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
</head>
<body>
  <a class="skip-link" href="#main"><%= t('nav.skip') %></a>

  <%#
    Two bands, which is the conventional admin arrangement:

      1. identity — who you are and how to leave, pinned to the right where
         people reach for it;
      2. sections — the five places you actually work, as tabs.

    Everything occasional (categories, authors, staff users, your own
    password) sits behind Ρυθμίσεις rather than competing for space in the
    tab row.
  -%>
  <header class="staff-header">
    <div class="staff-identity">
      <div class="container staff-identity__inner">
        <a class="staff-brand" href="/staff">
          <%- include('../partials/icon', { name: 'archive' }) %>
          <span><%= t('staff.area') %></span>
        </a>

        <div class="staff-identity__right">
          <%- include('../partials/theme-toggle', { theme: theme, themeUrl: themeUrl, t: t }) %>
          <span class="lang-switch">
            <% supportedLangs.forEach(function (code) { %>
              <% if (code !== lang) { %>
                <a class="lang-switch__link" href="<%= langUrl(code) %>" lang="<%= code %>"><%= code.toUpperCase() %></a>
              <% } %>
            <% }); %>
          </span>

          <% if (staffUser) { %>
            <a class="staff-identity__user" href="/staff/account">
              <%= staffUser.display_name %>
              <% if (staffUser.role === 'admin') { %>
                <span class="staff-identity__role"><%= t('staff.role.admin') %></span>
              <% } %>
            </a>

            <form class="inline-form" method="post" action="/staff/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button--secondary button--small" type="submit">
                <%= t('staff.logout') %>
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <nav class="staff-tabs" aria-label="<%= t('nav.menu') %>">
      <div class="container staff-tabs__inner">
        <%
          const sections = [
            { href: '/staff', key: 'staff.nav.dashboard', exact: true },
            { href: '/staff/books', key: 'staff.nav.books' },
            { href: '/staff/loans', key: 'staff.nav.loans' },
            { href: '/staff/borrowers', key: 'staff.nav.borrowers' },
          ];
          // One tab for everything occasional, active for any page it covers.
          const settingsPaths = [
            '/staff/settings', '/staff/categories', '/staff/authors',
            '/staff/users', '/staff/account',
          ];
        %>
        <% sections.forEach(function (item) { %>
          <%
            const active = item.exact
              ? currentPath === item.href || currentPath.startsWith(item.href + '?')
              : currentPath.startsWith(item.href);
          %>
          <a class="staff-tabs__tab" href="<%= item.href %>"<% if (active) { %> aria-current="page"<% } %>>
            <%= t(item.key) %>
          </a>
        <% }); %>

        <% const settingsActive = settingsPaths.some(function (p) { return currentPath.startsWith(p); }); %>
        <a class="staff-tabs__tab staff-tabs__tab--end" href="/staff/settings"
           <% if (settingsActive) { %>aria-current="page"<% } %>>
          <%- include('../partials/icon', { name: 'settings' }) %> <%= t('staff.nav.settings') %>
        </a>
      </div>
    </nav>
  </header>

  <main id="main" class="site-main">
    <div class="container">
      <%- include('../partials/flash', { flash: flash, t: t }) %>
    </div>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <p class="small"><a href="/"><%= t('staff.viewPublicSite') %></a></p>
      <p class="small faint"><%= libraryName %></p>
    </div>
  </footer>

  <script src="/assets/js/app.js" defer></script>
</body>
</html>
