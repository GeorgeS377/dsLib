<%#
  A bare layout for the login page: no navigation, no session controls, no
  links into the staff area. Nothing here hints at what the staff area
  contains, and there is no logged-in user to render.
-%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= t('staff.area') %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
</head>
<body>
  <main id="main" class="site-main">
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <p class="small"><a href="/">← <%= t('staff.viewPublicSite') %></a></p>
      <p class="small faint"><%= libraryName %></p>
    </div>
  </footer>
</body>
</html>
