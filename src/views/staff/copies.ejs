<%#
  Copy management for one title.

  The whole table is one form with one Save. It used to be a form per row,
  which meant editing three rows and pressing one Save silently discarded the
  other two — the kind of data loss nobody notices until a barcode is wrong.

  Long lists are paginated: a title bought as a class set can have scores of
  copies, and rendering every one as an editable row made the page heavy
  enough to stall the browser.

  The availability column is derived, not stored: a copy is available when its
  status is 'available' and it has no open loan.
-%>
<div class="container stack">

  <%- include('../partials/page-header', {
        t: t,
        trail: [
          { href: '/staff/books', label: t('staff.books.title') },
          { href: '/staff/books/' + book.id, label: book.title },
        ],
        crumb: t('staff.books.manageCopies'),
        heading: book.title,
        meta: t('staff.copies.availability') + ': '
              + book.copies_available + '/' + book.copies_total,
        actions: book.archived_at ? '' :
          `<a class="button button--quiet button--small" href="/books/${book.id}">`
          + `${t('staff.books.viewPublic')}</a>`,
      }) %>

  <% if (copies.total === 0) { %>
    <div class="state state--empty">
      <p class="state__icon"><%- include('../partials/icon', { name: 'book', size: 32 }) %></p>
      <h2 class="state__title"><%= t('staff.copies.empty') %></h2>
      <p class="state__body"><%= t('staff.copies.emptyHint') %></p>
    </div>
  <% } else { %>
    <form method="post" action="/staff/books/<%= book.id %>/copies/save">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="page" value="<%= copies.page %>">

      <div class="table-wrap">
        <table class="copies-table">
          <caption>
            <%= t('search.showing', {
                  from: (copies.page - 1) * copies.perPage + 1,
                  to: Math.min(copies.page * copies.perPage, copies.total),
                  total: copies.total }) %>
          </caption>
          <thead>
            <tr>
              <th scope="col"><%= t('staff.field.barcode') %></th>
              <th scope="col"><%= t('staff.field.shelf') %></th>
              <th scope="col"><%= t('staff.field.status') %></th>
              <th scope="col"><%= t('staff.copies.availability') %></th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <% copies.rows.forEach(function (copy) { %>
              <tr>
                <%# Every row's id travels with the form, so the handler knows
                    which rows to apply. -%>
                <td>
                  <input type="hidden" name="copy_id" value="<%= copy.id %>">
                  <label class="visually-hidden" for="barcode-<%= copy.id %>">
                    <%= t('staff.field.barcode') %>
                  </label>
                  <input type="text" id="barcode-<%= copy.id %>" name="barcode_<%= copy.id %>"
                         value="<%= copy.barcode || '' %>" maxlength="64" autocomplete="off">
                </td>
                <td>
                  <label class="visually-hidden" for="shelf-<%= copy.id %>">
                    <%= t('staff.field.shelf') %>
                  </label>
                  <input type="text" id="shelf-<%= copy.id %>" name="shelf_<%= copy.id %>"
                         value="<%= copy.shelf_location || '' %>" maxlength="100"
                         autocomplete="off">
                </td>
                <td>
                  <label class="visually-hidden" for="status-<%= copy.id %>">
                    <%= t('staff.field.status') %>
                  </label>
                  <select id="status-<%= copy.id %>" name="status_<%= copy.id %>">
                    <% statuses.forEach(function (status) { %>
                      <option value="<%= status %>" <%= copy.status === status ? 'selected' : '' %>>
                        <%= t('status.' + status) %>
                      </option>
                    <% }); %>
                  </select>
                </td>
                <td class="nowrap">
                  <% if (copy.open_loan_id) { %>
                    <span class="badge badge--loaned"><%= t('status.on_loan') %></span>
                    <span class="small faint">
                      <%= copy.open_loan_due_at.slice(0, 10) %>
                    </span>
                  <% } else if (copy.is_available) { %>
                    <span class="badge badge--available"><%= t('status.available') %></span>
                  <% } else { %>
                    <span class="badge badge--<%= copy.status %>"><%= t('status.' + copy.status) %></span>
                  <% } %>
                </td>
                <td class="nowrap">
                  <a class="small" href="/staff/copies/<%= copy.id %>/delete"><%= t('common.delete') %></a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="button-row mt-4">
        <button class="button" type="submit"><%= t('staff.copies.saveAll') %></button>
        <%# The page links below leave this form, so unsaved edits would go with
            them. Said out loud rather than discovered. -%>
        <% if (copies.totalPages > 1) { %>
          <span class="small muted"><%= t('staff.copies.saveBeforePaging') %></span>
        <% } %>
      </div>
    </form>

    <%- include('../partials/pagination', {
          results: copies, pages: pages, pageUrl: pageUrl, t: t }) %>
  <% } %>

  <div class="stack-lg">
    <section class="card">
      <h2 class="mt-0"><%= t('staff.copies.add') %></h2>

      <% if (errors.barcode) { %>
        <div class="error-summary" role="alert">
          <%- include('../partials/field-error', { hasT: hasT, code: errors.barcode, t: t }) %>
        </div>
      <% } %>

      <form method="post" action="/staff/books/<%= book.id %>/copies">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field">
          <label class="field__label" for="new-barcode"><%= t('staff.field.barcode') %>
            <span class="field__optional"><%= t('common.optional') %></span>
          </label>
          <input type="text" id="new-barcode" name="barcode" value="<%= values.barcode %>"
                 maxlength="64" autocomplete="off"
                 <%- errors.barcode ? 'aria-invalid="true"' : '' %>>
        </div>

        <div class="field">
          <label class="field__label" for="new-shelf"><%= t('staff.field.shelf') %>
            <span class="field__optional"><%= t('common.optional') %></span>
          </label>
          <input type="text" id="new-shelf" name="shelf_location"
                 value="<%= values.shelf_location %>" maxlength="100" autocomplete="off">
        </div>

        <div class="field">
          <label class="field__label" for="new-status"><%= t('staff.field.status') %></label>
          <select id="new-status" name="status">
            <% statuses.forEach(function (status) { %>
              <option value="<%= status %>" <%= values.status === status ? 'selected' : '' %>>
                <%= t('status.' + status) %>
              </option>
            <% }); %>
          </select>
        </div>

        <button class="button" type="submit"><%= t('staff.copies.add') %></button>
      </form>
    </section>

    <section class="card">
      <h2 class="mt-0"><%= t('staff.copies.addMany') %></h2>
      <p class="muted small"><%= t('staff.copies.addManyHint') %></p>

      <form method="post" action="/staff/books/<%= book.id %>/copies/bulk">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field">
          <label class="field__label" for="bulk-count"><%= t('staff.field.count') %></label>
          <input type="number" id="bulk-count" name="count" value="2" min="1" max="100" step="1"
                 required>
        </div>

        <div class="field">
          <label class="field__label" for="bulk-shelf"><%= t('staff.field.shelf') %>
            <span class="field__optional"><%= t('common.optional') %></span>
          </label>
          <input type="text" id="bulk-shelf" name="shelf_location" maxlength="100"
                 autocomplete="off">
        </div>

        <button class="button button--secondary" type="submit"><%= t('staff.copies.addMany') %></button>
      </form>
    </section>
  </div>

</div>
