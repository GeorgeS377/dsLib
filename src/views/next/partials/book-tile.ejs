<%#
  One title as a tile, for the grid. Worth switching to once the shelf has
  covers; until then the row says more.
-%>
<li class="tile">
  <%# Not a link, for the same reason as the row: the title carries it. -%>
  <span class="tile__cover" aria-hidden="true">
    <% if (book.cover_path) { %>
      <img src="/covers/<%= book.cover_path %>" alt="" width="150" height="225" loading="lazy">
    <% } else { %>
      <%- include('../../partials/icon', { name: 'shelf', size: 28 }) %>
    <% } %>
  </span>
  <div class="tile__body">
    <a class="tile__title list__link" href="/books/<%= book.id %>"><%= book.title %></a>
    <% if (book.authors) { %><p class="tile__author"><%= book.authors %></p><% } %>
    <span class="pill <%= book.copies_available > 0 ? '' : 'pill--warn' %>">
      <%= t('book.availableCount', {
            available: book.copies_available, total: book.copies_total , count: book.copies_total}) %>
    </span>
  </div>
</li>
