<%#
  One title as a row: cover, title, author, subject, shelf, availability.

  The default view, because most titles have no cover image yet and a grid of
  placeholders says less than a row of words does.
-%>
<div class="list__item">
  <%# Not a link: the title beside it goes to the same place, and a second
      link with no text of its own is one more thing for a screen reader to
      announce and a keyboard to stop at. -%>
  <span class="cover" aria-hidden="true">
    <% if (book.cover_path) { %>
      <img src="/covers/<%= book.cover_path %>" alt="" width="36" height="50">
    <% } else { %>
      <%- include('../../partials/icon', { name: 'shelf', size: 18 }) %>
    <% } %>
  </span>
  <div class="list__grow">
    <a class="list__title list__link" href="/books/<%= book.id %>"><%= book.title %></a>
    <div class="list__meta">
      <% if (book.authors) { %><%= book.authors %><% } %>
      <% if (book.categories) { %> · <%= book.categories %><% } %>
      <% if (book.shelf_locations) { %> · <%= book.shelf_locations %><% } %>
    </div>
  </div>
  <span class="pill <%= book.copies_available > 0 ? '' : 'pill--warn' %>">
    <%= t('book.availableCount', {
          available: book.copies_available, total: book.copies_total , count: book.copies_total}) %>
  </span>
</div>
