<%#
  Library announcements: opening hours, rules, whatever the term brings.

  Shown only when there is something to say. An empty panel headed
  "Ανακοινώσεις" on every visit teaches people to stop reading it.
-%>
<% if (announcements && announcements.length > 0) { %>
  <section class="panel announce">
    <h2 class="label"><%= t('home.announcements') %></h2>
    <ul class="stack list--plain mt-3">
      <% announcements.forEach(function (item) { %>
        <li class="announce__item">
          <%# The mark is centred against the notice and given a tile of its
              own: loose beside the text at 16px it read as a stray glyph. -%>
          <span class="announce__mark" aria-hidden="true">
            <%- include('../../partials/icon', { name: 'tag', size: 17 }) %>
          </span>
          <div class="announce__body">
            <p class="announce__title"><%= item.title %></p>
            <% if (item.body) { %><p class="muted small"><%= item.body %></p><% } %>
            <% if (item.link_url) { %>
              <%# rel="noopener" on a new tab: the page being opened must not
                  get a handle on this one. -%>
              <p class="small mt-1">
                <a href="<%= item.link_url %>"
                   <% if (item.link_new_tab) { %>target="_blank" rel="noopener noreferrer"<% } %>>
                  <%= t('staff.announcements.openLink') %>
                  <% if (item.link_new_tab) { %>
                    <span class="visually-hidden"><%= t('staff.announcements.newTab') %></span>
                  <% } %>
                </a>
              </p>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ul>
  </section>
<% } %>
