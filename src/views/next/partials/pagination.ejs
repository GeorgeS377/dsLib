<%#
  Pagination. Expects `results` ({ page, totalPages }), `pages` (the window
  from pageWindow(), with nulls for gaps) and `pageUrl(n)`.

  Every link is built by pageUrl, which carries the current search and filter
  parameters — this is what makes filters survive page navigation.
-%>
<% if (results.totalPages > 1) { %>
  <nav class="row" aria-label="<%= t('pagination.label') %>" style="justify-content:center">
    <% if (results.page > 1) { %>
      <a class="btn btn--ghost btn--small" href="<%= pageUrl(results.page - 1) %>" rel="prev">
        <%- include('../../partials/icon', { name: 'chevron-left', size: 15 }) %>
        <%= t('pagination.previous') %>
      </a>
    <% } %>

    <% pages.forEach(function (page) { %>
      <% if (page === null) { %>
        <span class="faint" aria-hidden="true">…</span>
      <% } else if (page === results.page) { %>
        <span class="btn btn--small" aria-current="page"
              aria-label="<%= t('pagination.page', { current: page, total: results.totalPages }) %>"><%= page %></span>
      <% } else { %>
        <a class="btn btn--ghost btn--small" href="<%= pageUrl(page) %>"><%= page %></a>
      <% } %>
    <% }); %>

    <% if (results.page < results.totalPages) { %>
      <a class="btn btn--ghost btn--small" href="<%= pageUrl(results.page + 1) %>" rel="next">
        <%= t('pagination.next') %>
        <%- include('../../partials/icon', { name: 'chevron-right', size: 15 }) %>
      </a>
    <% } %>
  </nav>
<% } %>
