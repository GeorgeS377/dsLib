<!DOCTYPE html>
<%#
  The sign-in page, and anything else reached without an account.

  Same bar as the rest of the staff area minus what needs an account: no page
  links, no name, no sign-out — but the library name still links back to the
  public catalogue, so arriving here from the public site is not a dead end.

  No bottom bar either: its four destinations all require signing in.
-%>
<html lang="<%= lang %>"<% if (theme === 'dark') { %> data-theme="dark"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# The library's name here too: the tab for a page nobody has signed in
      on should not be headed with the name of the office behind it. -%>
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= libraryName %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="<%= stylesheet %>">
  <%- include('../../partials/brand-head', { brandIcon: brandIcon }) %>
</head>
<body>
  <a class="skip-link" href="#main"><%= t('nav.skip') %></a>

  <header class="bar">
    <div class="wrap bar__inner">
      <a class="bar__brand" href="/">
        <%- include('../partials/brand-mark', { brandIcon: brandIcon }) %>
        <%# The library's name, not the admin area's: nobody has signed in
            yet, so this is still the front door. -%>
        <span><%= libraryName %></span>
      </a>
      <a class="bar__who plain" href="/" >
        <%- include('../../partials/icon', { name: 'chevron-left', size: 15 }) %>
        <%= t('staff.viewPublicSite') %>
      </a>
    </div>
  </header>

  <main id="main">
    <div class="wrap stack-lg">
      <%- include('../partials/flash', { flash: flash, t: t }) %>
      <%- body %>
    </div>
  </main>

  <footer class="foot">
    <div class="wrap foot__inner">
      <a href="<%= themeUrl(theme === 'dark' ? 'light' : 'dark') %>">
        <%= theme === 'dark' ? t('theme.switchToLight') : t('theme.switchToDark') %>
      </a>
      <% supportedLangs.forEach(function (code) { %>
        <% if (code !== lang) { %>
          <a href="<%= langUrl(code) %>"><%= t('lang.' + code) %></a>
        <% } %>
      <% }); %>
    </div>
  </footer>
  <%# The sign-in page is enhanced too — the show-password control is wired
      up here. Without this tag it rendered and did nothing. -%>
  <script src="/assets/js/app.js" defer></script>
</body>
</html>
