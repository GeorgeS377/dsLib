<%# Subjects. Renaming one keeps its address, so links already given out keep
    working — that is what the slug field is for. -%>
<div class="stack-lg">

  <h1><%= t('staff.categories.title') %></h1>

  <% if (categories.length === 0) { %>
    <div class="state"><h2 class="state__title"><%= t('staff.categories.empty') %></h2></div>
  <% } else { %>
    <div class="list">
      <% categories.forEach(function (category) { %>
        <div class="list__item">
          <div class="list__grow">
            <a class="list__title list__link" href="/categories/<%= category.slug %>"><%= category.name %></a>
            <div class="list__meta mono"><%= category.slug %></div>
          </div>
          <span class="pill pill--quiet"><%= category.book_count %></span>
          <a class="btn btn--ghost btn--small" href="/staff/categories/<%= category.id %>"><%= t('common.edit') %></a>
          <a class="small" href="/staff/categories/<%= category.id %>/delete"><%= t('common.delete') %></a>
        </div>
      <% }); %>
    </div>
  <% } %>

  <section class="panel">
    <h2><%= editing ? t('common.edit') : t('staff.categories.add') %></h2>

    <form method="post" action="<%= editing ? '/staff/categories/' + editing.id : '/staff/categories' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="field__label" for="name"><%= t('staff.field.name') %></label>
        <input type="text" id="name" name="name" value="<%= values.name %>" required maxlength="100"
               <%- errors.name ? 'aria-invalid="true"' : '' %>>
        <%- include('../partials/field-error', { hasT: hasT, code: errors.name, t: t }) %>
      </div>

      <div>
        <label class="field__label" for="description"><%= t('book.description') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <textarea id="description" name="description" rows="3" maxlength="1000"><%= values.description %></textarea>
      </div>

      <div class="btn-row">
        <button class="btn" type="submit"><%= t('common.save') %></button>
        <% if (editing) { %>
          <a class="btn btn--quiet" href="/staff/categories"><%= t('common.cancel') %></a>
        <% } %>
      </div>
    </form>
  </section>

</div>
