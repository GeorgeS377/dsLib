<%#
  Take a book back by barcode.

  The search on the home page is the other way in, and the better one when the
  copy was never labelled — this page is for a scanner: one field, Enter, done.
-%>
<div class="stack-lg">

  <div class="panel__head">
    <h1><%= t('staff.loans.checkin') %></h1>
    <a class="btn btn--ghost" href="/staff/search"><%= t('staff.loans.checkout') %></a>
  </div>

  <section class="panel">
    <form method="post" action="/staff/loans/checkin">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="field__label" for="barcode"><%= t('staff.loans.scanBarcode') %></label>
        <span class="field__hint"><%= t('staff.loans.scanHint') %></span>
        <input type="text" id="barcode" name="barcode" value="<%= barcode %>"
               autocomplete="off" autocapitalize="none" spellcheck="false" autofocus required>
      </div>
      <button class="btn" type="submit"><%= t('staff.loans.checkin') %></button>
    </form>
    <p class="field__hint">
      <%= t('staff.loans.checkinBySearch') %>
      <a href="/staff/search"><%= t('staff.search.title') %></a>
    </p>
  </section>

  <% if (recent.length > 0) { %>
    <section>
      <h2 class="label"><%= t('staff.loans.recentReturns') %></h2>
      <div class="table-wrap" style="margin-top:var(--s-3)">
        <table>
          <thead>
            <tr>
              <th scope="col"><%= t('staff.loan.book') %></th>
              <th scope="col"><%= t('staff.loan.borrower') %></th>
              <th scope="col"><%= t('staff.loans.returnedAt') %></th>
            </tr>
          </thead>
          <tbody>
            <% recent.forEach(function (loan) { %>
              <tr>
                <td><a class="list__link" href="/staff/books/<%= loan.book_id %>"><%= loan.book_title %></a></td>
                <td><%= loan.borrower_name %></td>
                <td class="nowrap faint small"><%= loan.returned_at.slice(0, 10) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>

</div>
