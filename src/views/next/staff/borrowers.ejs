<%#
  The readers.

  The long note about what is stored is not repeated here: it belongs with the
  form that does the storing, and at the top of a list it was a paragraph
  everyone scrolled past. The add form below carries the short version.
-%>
<div class="stack-lg">

  <div class="panel__head">
    <h1><%= t('staff.borrowers.title') %></h1>
  </div>

  <form class="search" method="get" action="/staff/borrowers" role="search">
    <label class="visually-hidden" for="q"><%= t('staff.borrowers.search') %></label>
    <input type="search" id="q" name="q" value="<%= q || '' %>"
           placeholder="<%= t('staff.borrowers.search') %>" autocomplete="off">
    <button class="btn btn--ghost" type="submit"><%= t('common.search') %></button>
  </form>

  <% if (results.total === 0) { %>
    <div class="state">
      <h2 class="state__title"><%= q ? t('search.empty.title') : t('staff.borrowers.empty') %></h2>
      <p><%= t('staff.borrowers.emptyHint') %></p>
    </div>
  <% } else { %>
    <section>
      <p class="muted small" role="status">
        <%= t('search.showing', { from: range.from, to: range.to, total: range.total }) %>
      </p>

      <div class="list" style="margin-top:var(--s-3)">
        <% results.rows.forEach(function (person) { %>
          <%
            const initials = String(person.display_name || '')
              .split(/\s+/).filter(Boolean).slice(0, 2)
              .map(function (part) { return part[0]; }).join('').toUpperCase();
          -%>
          <div class="list__item">
            <span class="initials" aria-hidden="true"><%= initials %></span>
            <div class="list__grow">
              <a class="list__title list__link" href="/staff/borrowers/<%= person.id %>"><%= person.display_name %></a>
              <div class="list__meta">
                <% if (person.school_class) { %><%= person.school_class %> · <% } %>
                <%= person.open_loans > 0
                      ? t('staff.search.holding', { count: person.open_loans })
                      : t('staff.search.holdingNone') %>
                · <%= t('staff.borrowers.totalLoans') %>: <%= person.total_loans %>
              </div>
            </div>
            <% if (person.is_anonymized) { %>
              <span class="pill pill--quiet"><%= t('staff.borrowers.anonymize') %></span>
            <% } %>
            <% if (person.overdue_loans > 0) { %>
              <span class="pill pill--warn"><%= t('staff.stat.overdue') %></span>
            <% } %>
          </div>
        <% }); %>
      </div>
    </section>

    <%- include('../partials/pagination', {
          results: results, pages: pages, pageUrl: pageUrl, t: t }) %>
  <% } %>

  <section class="panel">
    <h2><%= t('staff.borrowers.add') %></h2>

    <% if (Object.keys(errors).length > 0) { %>
      <div class="flash flash--error" role="alert">
        <%- include('../partials/field-error', { hasT: hasT, code: errors.display_name, t: t }) %>
      </div>
    <% } %>

    <form method="post" action="/staff/borrowers">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="field__label" for="display_name"><%= t('staff.borrowers.name') %></label>
        <input type="text" id="display_name" name="display_name" value="<%= values.display_name %>"
               required maxlength="200" autocomplete="off"
               <%- errors.display_name ? 'aria-invalid="true"' : '' %>>
      </div>

      <div>
        <label class="field__label" for="school_class"><%= t('staff.borrowers.class') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <input type="text" id="school_class" name="school_class" value="<%= values.school_class %>"
               maxlength="60" list="class-options" autocomplete="off">
        <datalist id="class-options">
          <% classes.forEach(function (name) { %>
            <option value="<%= name %>"></option>
          <% }); %>
        </datalist>
      </div>

      <button class="btn" type="submit"><%= t('staff.borrowers.add') %></button>
    </form>
  </section>

</div>
