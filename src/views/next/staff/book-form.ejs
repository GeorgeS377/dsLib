<%#
  Add or edit a title.

  One column, labels above fields. Authors get one input each so a
  surname-first name containing a comma stays one person; categories are
  checkboxes, because a multiple-select cannot be multi-selected without
  Ctrl+click and draws its chosen rows in the grey it uses for disabled ones.
-%>
<div class="stack-lg">

  <h1><%= book ? book.title : t('staff.books.new') %></h1>

  <% if (book && book.archived_at) { %>
    <div class="flash flash--warning" role="status">
      <span><%= t('staff.books.isArchived') %></span>
    </div>
  <% } %>

  <% const errorKeys = Object.keys(errors || {}); %>
  <% if (errorKeys.length > 0) { %>
    <div class="flash flash--error" role="alert">
      <span>
        <strong><%= t('error.summary.title') %></strong>
        <% errorKeys.forEach(function (key, index) { %>
          <%= index > 0 ? ' · ' : ' ' %>
          <a href="#field-<%= key %>">
            <%= t('staff.field.' + key) !== 'staff.field.' + key ? t('staff.field.' + key) : key %>
          </a>
          — <%= hasT('error.field.' + errors[key]) ? t('error.field.' + errors[key]) : t('error.field.generic') %>
        <% }); %>
      </span>
    </div>
  <% } %>

  <% if (typeof duplicate !== 'undefined' && duplicate) { %>
    <div class="flash flash--error" role="alert">
      <span>
        <%= t('error.field.duplicate_isbn') %>
        <a href="/staff/books/<%= duplicate.id %>"><%= duplicate.title %></a>
      </span>
    </div>
  <% } %>

  <section class="panel">
    <%# Multipart because the cover is saved with the title rather than as a
        second errand. Repeated names (authors, categories) survive it as
        arrays, so nothing about how this form is read had to change. -%>
    <form method="post" enctype="multipart/form-data"
          action="<%= book ? '/staff/books/' + book.id : '/staff/books' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <%# First, because it is the thing the librarian is holding when they sit
          down with a new book. It lives inside the main form so one Save
          stores the title and its cover together, which also means a title
          can have one from the moment it is created. -%>
      <fieldset>
        <legend><%= t('staff.field.cover') %></legend>

        <%# A cover that survived a refused submit. The file input beside it is
            empty — a browser will not refill one — so without this the framing
            would be silently gone and the title saved bare. -%>
        <% const kept = typeof pendingCover !== 'undefined' && pendingCover; %>
        <% if (kept) { %>
          <input type="hidden" name="pending_cover" value="<%= kept.coverPath %>">
          <input type="hidden" name="pending_thumb" value="<%= kept.thumbPath %>">
          <img class="cover-current" src="/covers/<%= kept.thumbPath %>"
               alt="<%= t('staff.field.cover') %>">
          <p class="field__hint"><%= t('staff.cover.kept') %></p>
        <% } else if (book && book.cover_path) { %>
          <img class="cover-current" src="/covers/<%= book.cover_thumb_path || book.cover_path %>"
               alt="<%= t('book.coverAlt', { title: book.title }) %>">
        <% } %>

        <%# The stage is hidden until a file is chosen, and stays hidden with
            no scripting — where the whole image uploads, as it always has.
            The four coordinates are what the server crops to. -%>
        <div class="cropper" data-cropper>
          <div>
            <label class="field__label" for="field-cover">
              <%= book && book.cover_path ? t('staff.cover.replace') : t('staff.cover.upload') %>
            </label>
            <span class="field__hint"><%= t('staff.cover.hint', { mb: maxUploadMb }) %></span>
            <input type="file" id="field-cover" name="cover" data-cropper-file
                   accept="image/jpeg,image/png,image/webp">
          </div>

          <div class="cropper__stage" data-cropper-stage hidden>
            <p class="field__hint"><%= t('staff.cover.dragHint') %></p>
            <canvas class="cropper__canvas" data-cropper-canvas
                    aria-label="<%= t('staff.cover.frame') %>"></canvas>
            <div class="cropper__zoom">
              <label class="field__label" for="field-cover-zoom"><%= t('staff.cover.zoom') %></label>
              <input type="range" id="field-cover-zoom" min="1" max="4" step="0.01" value="1"
                     data-cropper-zoom>
            </div>
          </div>

          <input type="hidden" name="crop_x" data-cropper-x>
          <input type="hidden" name="crop_y" data-cropper-y>
          <input type="hidden" name="crop_w" data-cropper-w>
          <input type="hidden" name="crop_h" data-cropper-h>
        </div>
      </fieldset>

      <div>
        <label class="field__label" for="field-title"><%= t('staff.field.title') %></label>
        <input type="text" id="field-title" name="title" value="<%= values.title %>" required
               maxlength="500" <%- errors.title ? 'aria-invalid="true"' : '' %>>
        <%- include('../partials/field-error', { hasT: hasT, code: errors.title, t: t }) %>
      </div>

      <div>
        <label class="field__label" for="field-subtitle"><%= t('staff.field.subtitle') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <input type="text" id="field-subtitle" name="subtitle" value="<%= values.subtitle %>"
               maxlength="500">
      </div>

      <fieldset data-repeatable>
        <legend><%= t('staff.field.authors') %></legend>
        <p class="field__hint"><%= t('staff.field.authorsHint') %></p>
        <%# Suggestions come with the page rather than over the wire, so they
            work the moment the field is focused and cost nothing when they
            are not used. One option per author: a name with a comma in it is
            one person, and splitting on the comma would invent a second. -%>
        <%- include('../partials/suggest', {
              id: 'author-options',
              options: authorOptions.map(function (a) { return a.name; }),
              fold: fold,
            }) %>
        <div data-repeatable-list class="stack">
          <% values.authors.forEach(function (name, index) { %>
            <div data-repeatable-row>
              <label class="visually-hidden" for="field-author-<%= index %>">
                <%= t('staff.field.authors') %> <%= index + 1 %>
              </label>
              <input type="text" id="field-author-<%= index %>" name="authors"
                     value="<%= name %>" maxlength="200" autocomplete="off"
                     list="author-options" data-suggest>
            </div>
          <% }); %>
          <%# One spare row, so an author can be added with no scripting. -%>
          <div data-repeatable-row>
            <label class="visually-hidden" for="field-author-extra"><%= t('staff.field.addAuthor') %></label>
            <input type="text" id="field-author-extra" name="authors" value=""
                   maxlength="200" autocomplete="off" list="author-options" data-suggest>
          </div>
        </div>
        <button class="btn btn--ghost btn--small" type="button" data-repeatable-add hidden>
          + <%= t('staff.field.addAuthor') %>
        </button>
      </fieldset>

      <div>
        <label class="field__label" for="field-isbn"><%= t('staff.field.isbn') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <span class="field__hint"><%= t('staff.field.isbnHint') %></span>
        <input type="text" id="field-isbn" name="isbn" value="<%= values.isbn %>" maxlength="32"
               inputmode="numeric" autocomplete="off"
               <%- errors.isbn ? 'aria-invalid="true"' : '' %>>
        <%- include('../partials/field-error', { hasT: hasT, code: errors.isbn, t: t }) %>
      </div>

      <div>
        <label class="field__label" for="field-publisher"><%= t('staff.field.publisher') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <input type="text" id="field-publisher" name="publisher" value="<%= values.publisher %>"
               maxlength="200">
      </div>

      <div>
        <label class="field__label" for="field-publication_year"><%= t('staff.field.year') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <input type="number" id="field-publication_year" name="publication_year"
               value="<%= values.publication_year %>" min="1400" max="2200"
               <%- errors.publication_year ? 'aria-invalid="true"' : '' %>>
        <%- include('../partials/field-error', { hasT: hasT, code: errors.publication_year, t: t }) %>
      </div>

      <div>
        <label class="field__label" for="field-edition"><%= t('staff.field.edition') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <input type="text" id="field-edition" name="edition" value="<%= values.edition %>"
               maxlength="100">
      </div>

      <div>
        <label class="field__label" for="field-language"><%= t('staff.field.language') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <span class="field__hint"><%= t('staff.field.languageHint') %></span>
        <input type="text" id="field-language" name="language" value="<%= values.language %>"
               maxlength="40" list="language-options" data-suggest>
        <%- include('../partials/suggest', {
              id: 'language-options', options: languages, fold: fold,
            }) %>
      </div>

      <fieldset id="field-categories">
        <legend><%= t('staff.field.categories') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </legend>
        <%# Naming a new subject here rather than sending the librarian to
            another page and back: the moment you discover a book needs one is
            the moment you are cataloguing it. A name already in use attaches
            that one instead of refusing — typing it plainly means "this one". -%>
        <div>
          <label class="field__label" for="field-new_category">
            <%= t('staff.field.newCategory') %>
            <span class="field__optional"><%= t('common.optional') %></span>
          </label>
          <span class="field__hint"><%= t('staff.field.newCategoryHint') %></span>
          <input type="text" id="field-new_category" name="new_category"
                 value="<%= values.new_category || '' %>" maxlength="100"
                 list="category-options" data-suggest autocomplete="off">
          <%- include('../partials/suggest', {
                id: 'category-options',
                options: categories.map(function (c) { return c.name; }),
                fold: fold,
              }) %>
        </div>

        <% if (categories.length === 0) { %>
          <p class="field__hint"><a href="/staff/categories"><%= t('staff.categories.add') %></a></p>
        <% } else { %>
          <p class="field__hint"><%= t('staff.field.categoriesHint') %></p>
          <div class="btn-row">
            <% categories.forEach(function (category) { %>
              <label class="btn btn--ghost btn--small choice">
                <input type="checkbox" name="categories" value="<%= category.id %>"
                       <%= values.categories.includes(category.id) ? 'checked' : '' %>>
                <%= category.name %>
              </label>
            <% }); %>
          </div>
        <% } %>
      </fieldset>

      <div>
        <label class="field__label" for="field-description"><%= t('staff.field.description') %>
          <span class="field__optional"><%= t('common.optional') %></span>
        </label>
        <textarea id="field-description" name="description" rows="5"><%= values.description %></textarea>
      </div>

      <div class="btn-row">
        <button class="btn" type="submit"><%= t('common.save') %></button>
        <a class="btn btn--quiet" href="/staff/books"><%= t('common.cancel') %></a>
      </div>
    </form>

    <%# Its own form: removing a cover is a different action from saving the
        title, and nesting forms is not a thing HTML allows. -%>
    <% if (book && book.cover_path) { %>
      <form method="post" action="/staff/books/<%= book.id %>/cover/delete">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost btn--small" type="submit"><%= t('staff.cover.remove') %></button>
      </form>
    <% } %>
  </section>

  <% if (book) { %>

    <section class="panel">
      <h2><%= t('staff.books.manageCopies') %></h2>
      <div class="btn-row">
        <a class="btn btn--ghost" href="/staff/books/<%= book.id %>/copies">
          <%= t('staff.books.manageCopies') %>
        </a>
        <% if (book.archived_at) { %>
          <form method="post" action="/staff/books/<%= book.id %>/unarchive">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--ghost" type="submit"><%= t('staff.books.restoreAction') %></button>
          </form>
        <% } else { %>
          <form method="post" action="/staff/books/<%= book.id %>/archive">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--ghost" type="submit"><%= t('staff.books.archiveAction') %></button>
          </form>
        <% } %>
        <a class="btn btn--danger" href="/staff/books/<%= book.id %>/delete"><%= t('common.delete') %></a>
      </div>
      <p class="field__hint"><%= t('staff.books.archiveExplain') %></p>
    </section>
  <% } %>

</div>
