<%# Deleting a staff account.
    The person's trail in the audit log survives this: entries keep the
    username as text, so the record of what they did does not go with the
    account. Their open sessions do not survive it. -%>
<div class="panel confirm centre">
  <h1><%= t('staff.users.deleteConfirm', { username: user.username }) %></h1>
  <p class="muted"><%= t('staff.users.deleteExplain') %></p>

  <form method="post" action="/staff/users/<%= user.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="btn-row">
      <button class="btn btn--danger" type="submit"><%= t('common.delete') %></button>
      <a class="btn btn--quiet" href="/staff/users"><%= t('common.cancel') %></a>
    </div>
  </form>
</div>
