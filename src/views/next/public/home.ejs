<%#
  The front page, which is the catalogue.

  There is no separate landing page: arriving at the library means arriving at
  the books. The search and the filters act on this page, and the results are
  underneath them — so finding a book takes no navigation at all.

  /books still renders the same thing for anyone who has that address.
-%>
<div class="stack-lg">

  <section>
    <h1><%= query.q ? t('search.resultsFor', { query: query.q }) : t('home.title') %></h1>

    <form class="search search--wide mt-4" method="get" action="/" role="search"
          data-live-search>
      <label class="visually-hidden" for="q"><%= t('common.searchLabel') %></label>
      <input type="search" id="q" name="q" value="<%= query.q || '' %>"
             placeholder="<%= t('common.searchPlaceholder') %>" autocomplete="off">
      <button class="btn" type="submit" aria-label="<%= t('common.search') %>">
        <%- include('../../partials/icon', { name: 'search', size: 17 }) %>
        <span class="btn__label"><%= t('common.search') %></span>
      </button>
    </form>

    <p class="muted small mt-3">
      <%# Two independent numbers, so each part carries its own singular and
          plural and this key only joins them. -%>
      <%= t('home.stats.summary', {
            titles: t('home.stats.titles', { count: stats.titles }),
            available: t('home.stats.available', { count: stats.copies_available }),
          }) %>
    </p>
  </section>

  <%# Filters and announcements are two different things being read at the
      same moment, not a sequence — stacked, the announcements pushed the
      filters and the books themselves down the page. Side by side above
      64rem, stacked below it, and the row only exists when there is
      something to announce. -%>
  <% const hasNotices = announcements && announcements.length > 0; %>
  <div class="<%= hasNotices ? 'home-split' : '' %>">
    <%- include('../partials/filters', {
          query: query, categories: categories, authors: authors, years: years,
          languages: languages, action: '/', hasFilters: hasFilters,
          clearUrl: clearUrl, t: t }) %>

    <%- include('../partials/announcements', { t: t, announcements: announcements }) %>
  </div>

  <%# Everything below updates as you type. The same markup is what a plain
      form submission renders, so the two can never drift apart. -%>
  <div data-live-results>
  <% if (results.total === 0) { %>
    <div class="state">
      <h2 class="state__title"><%= t('search.empty.title') %></h2>
      <p>
        <% if (query.q) { %><%= t('search.empty.withQuery', { query: query.q }) %>
        <% } else if (hasFilters) { %><%= t('search.empty.withFilters') %>
        <% } else { %><%= t('search.empty.catalogue') %><% } %>
      </p>
      <% if (query.q || hasFilters) { %>
        <p class="mt-4">
          <a class="btn btn--ghost" href="/">
            <%= hasFilters ? t('search.clearFilters') : t('search.clearSearch') %>
          </a>
        </p>
      <% } %>
    </div>
  <% } else { %>
    <section>
      <%- include('../partials/results', {
            results: results, range: range, viewMode: viewMode, viewUrl: viewUrl, t: t }) %>
    </section>

    <%- include('../partials/pagination', {
          results: results, pages: pages, pageUrl: pageUrl, t: t }) %>
  <% } %>
  </div>

</div>
