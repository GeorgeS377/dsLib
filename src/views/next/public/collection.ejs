<%# One subject or one author: the same results, under their own heading. -%>
<div class="stack-lg">

  <div>
    <nav aria-label="<%= t('nav.breadcrumb') %>" class="small muted">
      <a href="/books"><%= t('nav.catalogue') %></a>
    </nav>
    <h1 style="margin-top:var(--s-2)"><%= heading %></h1>
    <% if (lead) { %><p class="muted" style="margin-top:var(--s-2)"><%= lead %></p><% } %>
  </div>

  <% if (results.total === 0) { %>
    <div class="state">
      <h2 class="state__title"><%= t('search.empty.title') %></h2>
      <p><%= t('search.empty.catalogue') %></p>
    </div>
  <% } else { %>
    <section>
      <%- include('../partials/results', {
            results: results, range: range, viewMode: viewMode, viewUrl: viewUrl, t: t }) %>
    </section>

    <%- include('../partials/pagination', {
          results: results, pages: pages, pageUrl: pageUrl, t: t }) %>
  <% } %>

</div>
