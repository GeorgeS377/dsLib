<%#
  The catalogue. One search surface: the search box lives in the site header,
  the filters sit directly beneath the heading, and the results follow. There
  is deliberately no second search box on this page — the header already has
  one, and two identical fields on one screen is the clutter it looks like.
-%>
<div class="container stack">

  <div class="section-head">
    <h1 class="mt-0">
      <% if (query.q) { %>
        <%= t('search.resultsFor', { query: query.q }) %>
      <% } else { %>
        <%= t('search.title') %>
      <% } %>
    </h1>
    <% if (results.total > 0) { %>
      <p class="muted small" role="status">
        <%= t('search.showing', { from: range.from, to: range.to, total: range.total }) %>
      </p>
    <% } %>
  </div>

  <%- include('../partials/filters', {
        query: query, categories: categories, authors: authors, years: years,
        languages: languages, action: '/books', hasFilters: hasFilters,
        clearUrl: clearUrl, t: t }) %>

  <% if (results.total === 0) { %>
    <div class="state state--empty">
      <p class="state__icon"><%- include('../partials/icon', { name: 'search', size: 32 }) %></p>
      <h2 class="state__title"><%= t('search.empty.title') %></h2>
      <p class="state__body">
        <% if (query.q) { %>
          <%= t('search.empty.withQuery', { query: query.q }) %>
        <% } else if (hasFilters) { %>
          <%= t('search.empty.withFilters') %>
        <% } else { %>
          <%= t('search.empty.catalogue') %>
        <% } %>
      </p>
      <%# The label names what is actually set: offering to clear "filters"
          after a plain search pointed at something the reader never applied. -%>
      <% if (query.q || hasFilters) { %>
        <p>
          <a class="button button--secondary" href="/books">
            <%= hasFilters ? t('search.clearFilters') : t('search.clearSearch') %>
          </a>
        </p>
      <% } %>
    </div>
  <% } else { %>
    <ul class="book-grid">
      <% results.rows.forEach(function (book) { %>
        <%- include('../partials/book-card', { book: book, t: t }) %>
      <% }); %>
    </ul>

    <%- include('../partials/pagination', {
          results: results, pages: pages, pageUrl: pageUrl, t: t }) %>
  <% } %>

</div>
