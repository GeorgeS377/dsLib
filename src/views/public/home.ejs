<%#
  Home.

  The catalogue is what this site is for, so searching it is the first thing
  on the page rather than a welcome banner. Search and filters together, then
  what arrived recently.
-%>
<div class="container stack-lg">

  <section class="hero">
    <h1 class="hero__title"><%= t('home.title') %></h1>
    <p class="hero__lead"><%= t('home.lead') %></p>

    <form class="search-form search-form--hero" method="get" action="/books" role="search">
      <label class="visually-hidden" for="q"><%= t('common.searchLabel') %></label>
      <input class="search-form__input" type="search" id="q" name="q"
             placeholder="<%= t('common.searchPlaceholder') %>"
             autocomplete="off" data-autofocus>
      <button class="button" type="submit"><%= t('common.search') %></button>
    </form>

    <%# The same filters as the catalogue page, so narrowing a search is
        possible from the first screen rather than only after one. -%>
    <%- include('../partials/filters', {
          query: query, categories: categories, authors: authors, years: years,
          languages: languages, action: '/books', hasFilters: false,
          clearUrl: '/books', t: t }) %>

    <% if (stats && stats.titles > 0) { %>
      <p class="hero__stats">
        <%= t('home.stats.summary', {
              titles: stats.titles, available: stats.copies_available }) %>
      </p>
    <% } %>
  </section>

  <section>
    <div class="section-head">
      <h2><%= t('home.recent') %></h2>
      <% if (recent.length > 0) { %>
        <a class="section-head__link" href="/books?sort=newest"><%= t('home.browseAll') %></a>
      <% } %>
    </div>

    <% if (recent.length === 0) { %>
      <div class="state state--empty">
        <p class="state__icon"><%- include('../partials/icon', { name: 'book', size: 32 }) %></p>
        <h3 class="state__title"><%= t('home.recentEmpty') %></h3>
        <p class="state__body"><%= t('home.recentEmptyHint') %></p>
      </div>
    <% } else { %>
      <ul class="book-grid">
        <% recent.forEach(function (book) { %>
          <%- include('../partials/book-card', { book: book, t: t }) %>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <% if (topCategories.length > 0) { %>
    <section>
      <div class="section-head">
        <h2><%= t('home.categories') %></h2>
        <a class="section-head__link" href="/categories"><%= t('categories.title') %></a>
      </div>
      <ul class="chip-list">
        <% topCategories.forEach(function (category) { %>
          <li>
            <a class="chip" href="/books?category=<%= category.id %>">
              <%= category.name %>
              <span class="chip__count"><%= category.book_count %></span>
            </a>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>

</div>
